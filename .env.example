# GitHub personal access token (increases rate limit from 60 to 5,000 req/hr)
# Get one at: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# Optional: Ollama server URL for local LLM summaries
OLLAMA_URL=

# Optional: Hugging Face API token for cloud LLM summaries
HF_API_TOKEN=

# Optional: Web cache TTL in seconds (default: 3600)
GITWHO_CACHE_TTL=3600
